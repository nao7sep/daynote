<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables (their own in-process runner). -->
    <OutputType>Exe</OutputType>
    <StartupObject>DayNote.Tests.FixtureHarnessEntryPoint</StartupObject>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <!-- The Desktop host is a WinExe; referencing it for its assembly warns about the
         output-type mismatch. The test host only consumes the produced assembly. -->
    <NoWarn>$(NoWarn);NU1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Code coverage: coverlet.collector (the cross-platform .NET standard), run as
         a VSTest data collector with the "XPlat Code Coverage" collector (cobertura;
         see the tests-folder convention for the command). The MTP-native
         Microsoft.Testing.Extensions.CodeCoverage was incompatible with the
         Microsoft.Testing.Platform version that xunit.v3 3.2.2 pins, so Coverlet is
         used instead. -->
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Avalonia.Headless.XUnit 12.1.4 calls xUnit 3.2.2 discovery internals and fails
         discovery under xUnit 4 (MissingMethodException in AvaloniaFactDiscoverer). Keep xunit.v3
         on 3.2.2 until Avalonia publishes compatible integration (AvaloniaUI/Avalonia#22072);
         the 4.x runner runs it. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!-- Official xUnit headless integration ([AvaloniaFact]); depends on xunit.v3. -->
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DayNote\DayNote.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Twitter's official twitter-text conformance vectors, vendored verbatim for the weighted-length
         tests. Source: https://github.com/twitter/twitter-text/blob/master/conformance/validate.yml -->
    <None Include="Text\Conformance\twitter-text-validate.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
