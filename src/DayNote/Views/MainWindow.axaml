<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DayNote.ViewModels"
        xmlns:ctl="using:DayNote.Controls"
        x:Class="DayNote.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DayNote"
        Icon="/Assets/icon.png"
        Width="1200" Height="800"
        Background="{DynamicResource AppBackgroundBrush}"><!-- The window inherits the application's
        theme variant (AppTheme), which Avalonia also uses to paint the native title bar. -->

    <!-- Accelerators are driven from ShortcutCatalog in code-behind so the command key resolves to
         Cmd on macOS and Ctrl on Windows (a static XAML gesture cannot do that). -->

    <Window.Styles>
        <!-- The status-bar X budget: a bright primary count that turns danger-red over the limit. The
             base color is set via this class (not a local value) so the .over setter can override it —
             a local Foreground would win over a style setter and the red would never show. -->
        <Style Selector="TextBlock.xcount">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.xcount.over">
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.pane">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <!-- State colors. The view models expose state (a note's lifecycle, the save state, a result's
             severity) and these styles map it to theme brushes, so an open window repaints when the
             theme changes. -->
        <Style Selector="Border.statusStripe">
            <Setter Property="Background" Value="{DynamicResource StatusDraftBrush}"/>
        </Style>
        <Style Selector="Border.statusStripe.ready">
            <Setter Property="Background" Value="{DynamicResource StatusReadyBrush}"/>
        </Style>
        <Style Selector="Border.statusStripe.published">
            <Setter Property="Background" Value="{DynamicResource StatusPublishedBrush}"/>
        </Style>
        <Style Selector="Border.statusStripe.expired">
            <Setter Property="Background" Value="{DynamicResource StatusExpiredBrush}"/>
        </Style>
        <Style Selector="TextBlock.statusLabel">
            <Setter Property="Foreground" Value="{DynamicResource StatusDraftBrush}"/>
        </Style>
        <Style Selector="TextBlock.statusLabel.ready">
            <Setter Property="Foreground" Value="{DynamicResource StatusReadyBrush}"/>
        </Style>
        <Style Selector="TextBlock.statusLabel.published">
            <Setter Property="Foreground" Value="{DynamicResource StatusPublishedBrush}"/>
        </Style>
        <Style Selector="TextBlock.statusLabel.expired">
            <Setter Property="Foreground" Value="{DynamicResource StatusExpiredBrush}"/>
        </Style>
        <Style Selector="Ellipse.saveDot">
            <Setter Property="Fill" Value="{DynamicResource PositiveBrush}"/>
        </Style>
        <Style Selector="Ellipse.saveDot.saving">
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Ellipse.saveDot.unsaved">
            <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
        </Style>
        <Style Selector="Ellipse.saveDot.failed">
            <Setter Property="Fill" Value="{DynamicResource DangerTextBrush}"/>
        </Style>
        <Style Selector="Border.resultFrame">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.resultFrame.warning">
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
        </Style>
        <Style Selector="Border.resultFrame.error">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerTextBrush}"/>
        </Style>
        <!-- An app-shell result card. Severity sets its tint and its edge; the edge holds 3:1 against
             every workspace surface, so the card stands apart from whatever it floats over. -->
        <Style Selector="Border.shellResult">
            <Setter Property="Background" Value="{DynamicResource ResultInfoBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12,8,12"/>
            <Setter Property="BoxShadow" Value="0 4 14 0 #40000000"/>
        </Style>
        <Style Selector="Border.shellResult.warning">
            <Setter Property="Background" Value="{DynamicResource ResultWarningBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
        </Style>
        <Style Selector="Border.shellResult.error">
            <Setter Property="Background" Value="{DynamicResource ResultErrorBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerTextBrush}"/>
        </Style>
        <!-- Give list rows breathing room so the title and subtitle lines do not touch. -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Styles>

    <ScrollViewer x:Name="WindowViewport"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <!-- Three reserved tracks (toolbar / pane track / status bar) so the fixed chrome bars each own
         an auto-sized row and the star-sized middle track can never overlap the status bar (a
         DockPanel fill child can — see the window-chrome conventions). The pane track holds the four
         panes, with the app-shell results floating over them; WindowMetrics reserves the panes only. -->
    <Grid x:Name="LayoutRoot" RowDefinitions="Auto,*,Auto"
          Width="{Binding #WindowViewport.Viewport.Width}" Height="{Binding #WindowViewport.Viewport.Height}">
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,8" VerticalAlignment="Center">
                    <!-- The app name, always — never the open binder's title (that shows, highlighted, in the list). -->
                    <TextBlock Text="DayNote" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8">
                    <!-- Settings / Shortcuts / About live in a hamburger menu, matching the fleet. -->
                    <Button Classes="utility" Padding="8,6" ToolTip.Tip="Menu" AutomationProperties.Name="Menu">
                        <!-- Hamburger as a vector (three equal strokes); the glyph ☰ renders unevenly across
                             fonts. Bars 16 long and 2 thick with 5 between them: closer together they read as
                             one block rather than a menu, and the round caps stay inside the 18x16 box. -->
                        <Path Width="18" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" StrokeLineCap="Round"
                              UseLayoutRounding="True" Data="M1,1 H17 M1,8 H17 M1,15 H17"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Settings" Click="Settings_Click"/>
                                <MenuItem Header="Shortcuts" Click="Shortcuts_Click"/>
                                <MenuItem Header="About" Click="About_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar. Left: save state — a color-coded dot + label, shown whenever a binder is open.
             Right (single-document app, so the side-pane-flanked editor is narrow and the bar has the
             spare width): per-note metadata when a note is open — the counts cluster (bright) and the
             created/modified timestamps (muted), split by a thin rule — or the binder's note count when
             no note is selected, so the bar is never blank. The two right-side blocks share the column;
             only one carries content at a time. -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*" Margin="12,5">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                IsVisible="{Binding HasBinder}">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Classes="saveDot"
                                 Classes.saving="{Binding IsSaveStateSaving}"
                                 Classes.unsaved="{Binding IsSaveStateUnsaved}"
                                 Classes.failed="{Binding IsSaveStateError}"/>
                        <TextBlock Text="{Binding SaveStateText}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <!-- The applied text style, briefly: standing state belongs in the strip that is
                         always there, not in a card over the workspace. -->
                    <TextBlock Text="{Binding TextStyleStatusText}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite"
                               IsVisible="{Binding TextStyleStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            IsVisible="{Binding Editor.HasNote}">
                    <TextBlock Text="{Binding Editor.WordsText}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Editor.CharsText}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Editor.XCountText}" FontSize="12"
                               Classes="xcount" Classes.over="{Binding !Editor.IsWithinXLimit}"/>
                    <Border Width="1" Height="14" Margin="4,0" VerticalAlignment="Center"
                            Background="{DynamicResource BorderBrush}"/>
                    <TextBlock Text="{Binding Editor.CreatedText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Editor.ModifiedText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               IsVisible="{Binding Editor.ReadyAtText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding Editor.ReadyAtText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               IsVisible="{Binding Editor.ReadyAtText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               IsVisible="{Binding Editor.PublishedAtText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding Editor.PublishedAtText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               IsVisible="{Binding Editor.PublishedAtText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               IsVisible="{Binding Editor.ExpiredAtText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding Editor.ExpiredAtText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               IsVisible="{Binding Editor.ExpiredAtText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding BinderStatusText}" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
        </Border>

        <Grid x:Name="PaneTrack" Grid.Row="1">
        <!-- Four panes -->
        <Grid x:Name="PaneGrid" Margin="4">
            <Grid.ColumnDefinitions>
                <!-- The three side panes are pixel-sized; the editor is the sole star column (fill
                     pane) that absorbs window resize. The code-behind tracks each side pane's "intent"
                     (the pixel width the user last dragged it to) and re-derives the displayed width
                     as clamp(min, intent, whatFitsTheCurrentWindow) on every resize, so the side
                     panes stay fixed and only the editor grows or shrinks. The derived window minimum
                     sums these MinWidths, so at the minimum every pane sits at exactly its MinWidth
                     and none is clipped. -->
                <ColumnDefinition Width="220" MinWidth="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260" MinWidth="170"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260" MinWidth="170"/>
            </Grid.ColumnDefinitions>

            <!-- Binders -->
            <Border x:Name="BindersPane" Grid.Column="0" Classes="pane">
                <!-- Real content minimum (a side pane needs header + filter + a few rows). The
                     window minimum derives the editor pane's taller minimum (300); the side panes
                     get 200 so they are never crushed below a usable height. -->
                <DockPanel MinHeight="200">
                    <Border DockPanel.Dock="Top" Classes="paneHeader">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Binders" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Content="New" Classes="accent" Command="{Binding NewBinderCommand}"/>
                                <Button Content="Open" Classes="utility" Command="{Binding OpenBinderCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DockPanel Margin="10">
                        <ctl:ComposingTextBox DockPanel.Dock="Top" PlaceholderText="Filter…" Text="{Binding BindersFilter}" Margin="0,0,0,8"/>
                        <Panel>
                            <!-- Selecting a binder opens it (single click or arrow key); no double-click needed. -->
                            <ListBox x:Name="BindersList" ItemsSource="{Binding Binders}" DragDrop.AllowDrop="True"
                                     SelectedItem="{Binding SelectedBinder}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:BinderListItemViewModel">
                                    <!-- Primary label is the binder title (capitalized, human-friendly); the path
                                         below shows the lowercase file. Double-tap the row to rename the title. -->
                                    <Grid ColumnDefinitions="*,Auto,Auto" Background="Transparent" DoubleTapped="BinderRow_DoubleTapped">
                                        <StackPanel Spacing="2">
                                            <Panel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding !IsEditing}"/>
                                                <ctl:ComposingTextBox Text="{Binding EditText}" IsVisible="{Binding IsEditing}" SubmitOnEnter="True"
                                                         FontWeight="SemiBold" Padding="2,0" MinHeight="0"
                                                         Submitted="BinderTitle_Submitted" LostFocus="BinderTitle_LostFocus"
                                                         KeyDown="BinderTitle_KeyDown"/>
                                            </Panel>
                                            <!-- Truncate the START of the path so the file name (the useful end) stays visible. -->
                                            <TextBlock Text="{Binding Path}" FontSize="11" TextTrimming="PrefixCharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <!-- The row is where a missing file is reported: it is the narrowest owner
                                             of the condition, it already shows the path, and several missing
                                             binders each say it once. -->
                                        <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center"
                                                Margin="8,0,0,0" IsVisible="{Binding IsMissing}">
                                            <TextBlock Text="Missing" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DangerTextBrush}"/>
                                        </Border>
                                        <!-- Remove from the list (revealed on hover/selection). If it's the open
                                             binder, this closes it (flushing edits) first; closing == forgetting. -->
                                        <Button Grid.Column="2" Classes="rowAction" Click="RemoveBinderRow_Click"
                                                Classes.revealed="{Binding IsMissing}"
                                                ToolTip.Tip="Remove from list">
                                            <Path Width="10" Height="10" Stroke="{Binding $parent[Button].Foreground}"
                                                  StrokeThickness="1.6" StrokeLineCap="Round" Data="M1,1 L9,9 M9,1 L1,9"/>
                                        </Button>
                                    </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding BindersEmptyStateText}"
                                       IsVisible="{Binding BindersEmptyStateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       IsHitTestVisible="False" Margin="16" TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Panel>
                    </DockPanel>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="BindersSplitter" Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns"/>

            <!-- Notes -->
            <Border x:Name="NotesPane" Grid.Column="2" Classes="pane">
                <DockPanel MinHeight="200">
                    <Border DockPanel.Dock="Top" Classes="paneHeader">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Notes" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Content="New" Classes="accent"
                                    Command="{Binding NewNoteCommand}" IsEnabled="{Binding HasBinder}"/>
                        </Grid>
                    </Border>
                    <DockPanel Margin="10">
                        <ctl:ComposingTextBox x:Name="NotesFilterBox" DockPanel.Dock="Top" PlaceholderText="Filter…" Text="{Binding NotesFilter}" Margin="0,0,0,8"/>
                        <Panel>
                            <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}"
                                     KeyDown="NotesList_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:NoteListItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <!-- A status-colored stripe makes each row read by lifecycle state at a glance. -->
                                        <Border Width="3" CornerRadius="1.5" VerticalAlignment="Stretch"
                                                Classes="statusStripe"
                                                Classes.ready="{Binding IsStatusReady}"
                                                Classes.published="{Binding IsStatusPublished}"
                                                Classes.expired="{Binding IsStatusExpired}"/>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                                           Classes="statusLabel"
                                                           Classes.ready="{Binding IsStatusReady}"
                                                           Classes.published="{Binding IsStatusPublished}"
                                                           Classes.expired="{Binding IsStatusExpired}"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Per-row delete, revealed on hover/selection (replaces the Delete button). -->
                                        <Button Grid.Column="2" Classes="rowAction" Click="DeleteNoteRow_Click" ToolTip.Tip="Delete note">
                                            <Path Width="10" Height="10" Stroke="{Binding $parent[Button].Foreground}"
                                                  StrokeThickness="1.6" StrokeLineCap="Round" Data="M1,1 L9,9 M9,1 L1,9"/>
                                        </Button>
                                    </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding NotesEmptyStateText}"
                                       IsVisible="{Binding NotesEmptyStateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       IsHitTestVisible="False" Margin="16" TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Panel>
                    </DockPanel>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="NotesSplitter" Grid.Column="3" Width="6" Background="Transparent" ResizeDirection="Columns"/>

            <!-- Editor -->
            <Border x:Name="EditorPane" Grid.Column="4" Classes="pane">
                <!-- The editor is the tallest pane: it needs room for the header (title + status +
                     the metadata wrap) plus a usable body. Its 300 is the content minimum that
                     WindowMetrics folds into the window's minimum height (the tallest pane wins). -->
                <Panel MinHeight="300">
                    <TextBlock Text="Select a note, or create one." HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding !Editor.HasNote}"/>
                    <DockPanel IsVisible="{Binding Editor.HasNote}">
                        <!-- Header: title + lifecycle status in one row, then the body directly below (no
                             borderline — the metadata that used to sit here now lives in the status bar).
                             Published and expired notes are read-only until moved to draft or ready. -->
                        <Grid x:Name="EditorHeader" DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="10,10,10,6">
                            <ctl:ComposingTextBox x:Name="TitleBox"
                                                  Text="{Binding Editor.Title}" PlaceholderText="Title…"
                                                  FontSize="18" FontWeight="SemiBold" AcceptsReturn="False" SubmitOnEnter="True"
                                                  IsReadOnly="{Binding !Editor.IsEditable}"
                                                  Submitted="Title_Submitted" LostFocus="Title_LostFocus"/>
                            <!-- Shown when the note is locked (published or expired). -->
                            <Border Grid.Column="1" Classes="badge" Margin="8,0,0,0" IsVisible="{Binding !Editor.IsEditable}"
                                    ToolTip.Tip="This note is read-only — set its status to Draft or Ready to edit.">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Path Width="11" Height="12" Stretch="Uniform" Fill="Transparent"
                                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3"
                                          Data="M2,6 h8 v6 h-8 z M3.5,6 V4 a2.5,2.5 0 0 1 5,0 V6"/>
                                    <TextBlock Text="Read-only" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <ComboBox Grid.Column="2" Margin="8,0,0,0" MinWidth="130" VerticalAlignment="Center"
                                      ItemsSource="{Binding Editor.StatusOptions}"
                                      SelectedItem="{Binding Editor.Status}"
                                      ToolTip.Tip="Lifecycle status"/>
                        </Grid>
                        <ctl:ComposingTextBox x:Name="BodyBox" Margin="10,0,10,10"
                                 Text="{Binding Editor.Body}"
                                 IsReadOnly="{Binding !Editor.IsEditable}"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                 FontFamily="{Binding EditorFontFamily}" FontSize="{Binding EditorFontSize}"
                                 LineHeight="{Binding EditorLineHeight}" Padding="{Binding EditorPadding}"
                                 FontWeight="{Binding EditorFontWeight}" FontStyle="{Binding EditorFontStyle}"
                                 VerticalContentAlignment="Top"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Panel>
            </Border>

            <GridSplitter x:Name="AttachmentsSplitter" Grid.Column="5" Width="6" Background="Transparent" ResizeDirection="Columns"/>

            <!-- Attachments -->
            <Border x:Name="AttachPane" Grid.Column="6" Classes="pane" DragDrop.AllowDrop="True">
                <DockPanel MinHeight="200">
                    <Border x:Name="AttachmentsHeader" DockPanel.Dock="Top" Classes="paneHeader">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Attachments" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Content="Add" Classes="utility"
                                    Command="{Binding AddAttachmentCommand}" IsEnabled="{Binding CanEditNote}"/>
                        </Grid>
                    </Border>
                    <Border DockPanel.Dock="Top" Margin="10,10,10,0" Padding="10,8"
                            Background="{DynamicResource AppBackgroundBrush}"
                            Classes="resultFrame"
                            Classes.warning="{Binding AttachmentResult.IsWarning, FallbackValue=False}"
                            Classes.error="{Binding AttachmentResult.IsError, FallbackValue=False}" BorderThickness="1"
                            CornerRadius="6" IsVisible="{Binding HasAttachmentResult}"
                            AutomationProperties.Name="{Binding AttachmentResult.AccessibleMessage}"
                            AutomationProperties.LiveSetting="{Binding AttachmentResult.LiveSetting}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding AttachmentResult.Message}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Button Grid.Column="1" Classes="resultClose" VerticalAlignment="Top"
                                    Click="DismissAttachmentResult_Click" ToolTip.Tip="Close"
                                    AutomationProperties.Name="Close attachment result">
                                <Path Width="10" Height="10" Stroke="{Binding $parent[Button].Foreground}"
                                      StrokeThickness="1.6" StrokeLineCap="Round"
                                      Data="M1,1 L9,9 M9,1 L1,9"/>
                            </Button>
                        </Grid>
                    </Border>
                    <Panel Margin="10">
                        <!-- A bordered list like the binders/notes lists; rows have no inner border.
                             Rows can be dragged to reorder (wired in code-behind). -->
                        <ListBox x:Name="AttachList" ItemsSource="{Binding Attachments}" DragDrop.AllowDrop="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:AttachmentItemViewModel">
                                    <StackPanel Spacing="6" DoubleTapped="Attachment_DoubleTapped">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                        <Border Width="44" Height="44" CornerRadius="4" ClipToBounds="True"
                                                Background="{DynamicResource AppBackgroundBrush}">
                                            <Panel>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}"/>
                                                <!-- Generic document (folded corner) for non-images and failed previews. -->
                                                <Path Width="22" Height="28" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Fill="Transparent"
                                                      Data="M2,1 H18 L26,9 V33 H2 Z M18,1 V9 H26" IsVisible="{Binding ShowFilePlaceholder}"/>
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DetailsText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <!-- Same hover-✕ remove affordance as the other lists; a published or
                                             expired note keeps its attachments, as it keeps its text. -->
                                        <Button Grid.Column="2" Classes="rowAction" Click="RemoveAttachment_Click"
                                                IsVisible="{Binding $parent[ListBox].DataContext.CanEditNote}"
                                                ToolTip.Tip="Remove attachment">
                                            <Path Width="10" Height="10" Stroke="{Binding $parent[Button].Foreground}"
                                                  StrokeThickness="1.6" StrokeLineCap="Round" Data="M1,1 L9,9 M9,1 L1,9"/>
                                        </Button>
                                    </Grid>
                                    <Border Padding="8,6" Background="{DynamicResource AppBackgroundBrush}"
                                            Classes="resultFrame"
                                            Classes.warning="{Binding Result.IsWarning, FallbackValue=False}"
                                            Classes.error="{Binding Result.IsError, FallbackValue=False}"
                                            BorderThickness="1" CornerRadius="5"
                                            IsVisible="{Binding HasResult}"
                                            AutomationProperties.Name="{Binding Result.AccessibleMessage}"
                                            AutomationProperties.LiveSetting="{Binding Result.LiveSetting}">
                                        <TextBlock Text="{Binding Result.Message}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding AttachmentsEmptyStateText}"
                                   IsVisible="{Binding AttachmentsEmptyStateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   IsHitTestVisible="False" Margin="16" TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <!-- Drag-and-drop hover affordance, shown while files are dragged over the pane. -->
                        <Border IsVisible="{Binding IsAttachmentDropActive}" IsHitTestVisible="False"
                                Background="{DynamicResource SurfaceBrush}" Opacity="0.92"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="6">
                            <TextBlock Text="Drop files to attach" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </Panel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- App-shell results float over the bottom-right corner of the pane track, above the status
             bar. They take no layout space, so showing, updating, or dismissing one never moves a
             pane, and the window minimum reserves nothing for them. The newest result sits on top,
             so an arriving result never moves those already shown. The code-behind starts the
             host's region below the attachments header and the editor's title row, the headers it
             floats beside: a stack taller than that region scrolls, with its scroll bar kept in
             view, and its cards pass under those header lines and the status bar edge instead of
             covering the header controls.

             The host is the one stable live region: it takes the latest result's politeness first
             and then its message as its name, which is the change a platform announces. The empty
             host and the gaps between cards have no background, so pointer input reaches the panes
             everywhere except on a card. -->
        <Panel x:Name="ResultsHost" Width="392" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               AutomationProperties.LiveSetting="{Binding AnnouncedResult.LiveSetting, FallbackValue=Polite}"
               AutomationProperties.Name="{Binding AnnouncedResult.AccessibleMessage}">
            <ScrollViewer x:Name="ResultsViewport" IsVisible="{Binding HasResults}"
                          Background="{x:Null}" Padding="16" AllowAutoHide="False"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:OperationResultViewModel">
                            <Border Classes="shellResult"
                                    Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}">
                                <!-- A fixed line height centres the text in each line box, and the close
                                     button's negative margins give it exactly one line box of layout
                                     height: it centres on the first line, and a one-line card keeps
                                     equal room above and below its text. The larger hit area spills
                                     into the card's padding. -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" LineHeight="18"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Button Grid.Column="1" Classes="resultClose" Margin="0,-2"
                                            VerticalAlignment="Top" Click="DismissResult_Click"
                                            ToolTip.Tip="Close" AutomationProperties.Name="Close notification">
                                        <Path Width="10" Height="10" Stroke="{Binding $parent[Button].Foreground}"
                                              StrokeThickness="1.6" StrokeLineCap="Round"
                                              Data="M1,1 L9,9 M9,1 L1,9"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
